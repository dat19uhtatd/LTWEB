@model GradeFormViewModel
@{
    bool isEdit = Model.MaKhoiLop > 0;
    ViewData["Title"] = isEdit ? "Sửa khối lớp" : "Thêm khối lớp";
}
<partial name="_AdminNav" />
<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card-soft p-4 p-lg-5">
        <h4 class="section-title mb-4">@ViewData["Title"]</h4>
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" asp-for="MaKhoiLop" />
            <div class="mb-3"><label asp-for="TenKhoiLop" class="form-label"></label><input asp-for="TenKhoiLop" class="form-control" /><span asp-validation-for="TenKhoiLop"></span></div>
            <div class="mb-3"><label asp-for="CapHoc" class="form-label"></label>
                <select asp-for="CapHoc" class="form-select">
                    <option value="">-- Chọn cấp học --</option>
                    @foreach (var c in new[] { "Tiểu học", "THCS", "THPT", "Luyện thi", "Đại học" }) { <option value="@c" selected="@(Model.CapHoc == c)">@c</option> }
                </select><span asp-validation-for="CapHoc"></span></div>
            <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a><button class="btn btn-primary rounded-pill px-4">Lưu</button></div>
        </form>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
