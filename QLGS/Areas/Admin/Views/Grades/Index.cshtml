@model List<GradeRow>
@{
    ViewData["Title"] = "Quản lý khối lớp";
}
<partial name="_AdminNav" />
<div class="card-soft p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Danh mục khối lớp (@Model.Count)</h5>
        <a asp-action="Form" class="btn btn-primary rounded-pill px-4"><i class="fa-solid fa-plus me-1"></i>Thêm khối lớp</a>
    </div>
    <div class="table-responsive">
        <table class="table table-modern">
            <thead><tr><th>Khối lớp</th><th>Cấp học</th><th class="text-center">Gia sư nhận dạy</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold">@r.Grade.TenKhoiLop</td>
                        <td><span class="badge-soft m-0">@(r.Grade.CapHoc ?? "—")</span></td>
                        <td class="text-center">@r.TutorCount</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Form" asp-route-id="@r.Grade.MaKhoiLop" class="btn btn-sm btn-outline-primary rounded-pill"><i class="fa-solid fa-pen"></i></a>
                            <form asp-action="Delete" asp-route-id="@r.Grade.MaKhoiLop" method="post" class="d-inline" data-confirm="Xóa @r.Grade.TenKhoiLop?"><button class="btn btn-sm btn-outline-danger rounded-pill"><i class="fa-solid fa-trash"></i></button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
