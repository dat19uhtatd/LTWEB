@model SubjectFormViewModel
@{
    bool isEdit = Model.MaMonHoc > 0;
    ViewData["Title"] = isEdit ? "Sửa môn học" : "Thêm môn học";
}
<partial name="_AdminNav" />
<div class="row justify-content-center"><div class="col-lg-6">
    <div class="card-soft p-4 p-lg-5">
        <h4 class="section-title mb-4">@ViewData["Title"]</h4>
        <form asp-action="Save" method="post" novalidate>
            <input type="hidden" asp-for="MaMonHoc" />
            <div class="mb-3"><label asp-for="TenMonHoc" class="form-label"></label><input asp-for="TenMonHoc" class="form-control" /><span asp-validation-for="TenMonHoc"></span></div>
            <div class="mb-3"><label asp-for="IconClass" class="form-label"></label><input asp-for="IconClass" class="form-control" placeholder="fa-calculator" /><div class="form-text">Xem danh sách icon tại fontawesome.com (bỏ tiền tố "fa-solid").</div><span asp-validation-for="IconClass"></span></div>
            <div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" class="form-control" rows="3"></textarea><span asp-validation-for="MoTa"></span></div>
            <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy</a><button class="btn btn-primary rounded-pill px-4">Lưu</button></div>
        </form>
    </div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
