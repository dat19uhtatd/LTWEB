@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<div class="auth-wrap py-3">
    <div class="row g-0 w-100 justify-content-center">
        <div class="col-lg-5 d-none d-lg-block">
            <div class="auth-side h-100 d-flex flex-column justify-content-center">
                <span class="brand-icon mb-4" style="width:56px;height:56px;font-size:1.5rem"><i class="fa-solid fa-graduation-cap"></i></span>
                <h2 class="fw-bold mb-3">Chào mừng trở lại EduMatch</h2>
                <p class="opacity-90">Đăng nhập để đặt lịch học thử, theo dõi yêu cầu, quản lý lớp học và bài tập của bạn.</p>
                <ul class="list-unstyled mt-3 mb-0 opacity-90">
                    <li class="mb-2"><i class="fa-solid fa-check me-2"></i>Tìm gia sư theo môn, khối, khu vực</li>
                    <li class="mb-2"><i class="fa-solid fa-check me-2"></i>Đặt lịch học thử 01 buổi</li>
                    <li><i class="fa-solid fa-check me-2"></i>Thời khóa biểu & nhắc lịch dạy</li>
                </ul>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card-soft p-4 p-lg-5 h-100" style="border-radius:0 24px 24px 0">
                <h3 class="fw-bold mb-1">Đăng nhập</h3>
                <p class="text-muted small mb-4">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p>

                <form asp-action="Login" method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fa-regular fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="email@example.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fa-solid fa-lock text-muted"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" id="pwInput" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePw" data-no-lock tabindex="-1"><i class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill">Đăng nhập</button>
                </form>

                <div class="demo-box mt-4 p-3 bg-light rounded-4 small">
                    <div class="fw-bold mb-2"><i class="fa-solid fa-flask me-1 text-primary"></i>Tài khoản demo (mật khẩu: <code>123456</code>) — bấm để điền nhanh</div>
                    <div><button type="button" data-email="admin@utc.edu.vn">• <strong>Admin:</strong> <code>admin@utc.edu.vn</code></button></div>
                    <div><button type="button" data-email="tuan.giasu@utc.edu.vn">• <strong>Gia sư:</strong> <code>tuan.giasu@utc.edu.vn</code></button></div>
                    <div><button type="button" data-email="lan.phuhuynh@gmail.com">• <strong>Phụ huynh:</strong> <code>lan.phuhuynh@gmail.com</code></button></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePw').addEventListener('click', function () {
            var i = document.getElementById('pwInput');
            i.type = i.type === 'password' ? 'text' : 'password';
            this.firstElementChild.className = i.type === 'password' ? 'fa-regular fa-eye' : 'fa-regular fa-eye-slash';
        });
        document.querySelectorAll('.demo-box button').forEach(function (b) {
            b.addEventListener('click', function () {
                document.getElementById('Email').value = b.dataset.email;
                document.getElementById('pwInput').value = '123456';
            });
        });
    </script>
}
