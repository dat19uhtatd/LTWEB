@model TutorDetailsViewModel
@{
    var t = Model.Tutor;
    var user = t.MaNguoiDungNavigation;
    ViewData["Title"] = "Gia sư " + user.HoTen;
    var visibleReviews = t.DanhGia.Where(x => x.HienThi == true).OrderByDescending(x => x.NgayDanhGia).ToList();
    int totalReviews = visibleReviews.Count;
    var free = t.MaTranLichRanh.Where(m => m.ConTrong == true)
        .Select(m => VnFormat.NormalizeDay(m.ThuTrongTuan) + "|" + VnFormat.NormalizeSession(m.BuoiTrongNgay)).ToHashSet();
    var subjectGroups = t.GiaSuMonHoc.GroupBy(g => g.MaMonHocNavigation.TenMonHoc).OrderBy(g => g.Key).ToList();
    var minTime = DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm");
    // Sau khi gửi form bị lỗi, đường dẫn hiện tại là URL của POST -> luôn quay về trang chi tiết (GET)
    var returnTo = Url.Action("Details", "Home", new { id = t.MaGiaSu });
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Tìm gia sư</a></li>
        <li class="breadcrumb-item active">@user.HoTen</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card-soft p-4 mb-4">
            <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                <partial name="_Avatar" model="@(new AvatarModel(user.HoTen, user.AnhDaiDien, t.MaGiaSu, 88))" />
                <div class="flex-grow-1">
                    <h2 class="fw-bold mb-1">@user.HoTen</h2>
                    <div class="text-muted mb-2">@t.TrinhDo@(string.IsNullOrEmpty(t.TruongDaoTao) ? "" : " • " + t.TruongDaoTao)</div>
                    @if (t.DaXacMinh == true)
                    {
                        <span class="badge-verified"><i class="fa-solid fa-circle-check me-1"></i>Đã xác minh bằng cấp / thẻ sinh viên</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2">Chưa xác minh</span>
                    }
                </div>
                <div class="text-end">
                    <div class="price fs-3">@t.HocPhiTheoGio.Vnd()<span class="small text-muted fw-normal">/giờ</span></div>
                    @if (totalReviews > 0)
                    {
                        <div><partial name="_Stars" model="(t.DiemDanhGiaTb ?? 0)" /> <strong>@((t.DiemDanhGiaTb ?? 0).ToString("0.0"))</strong> <span class="text-muted small">(@totalReviews đánh giá)</span></div>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success-emphasis">Gia sư mới - chưa có đánh giá</span>
                    }
                </div>
            </div>

            <div class="row g-3 mb-4 text-center">
                <div class="col-4"><div class="p-3 rounded-4 bg-light"><div class="fw-bold fs-5">@(t.SoLopDangDay ?? 0)</div><div class="small text-muted">Lớp đang dạy</div></div></div>
                <div class="col-4"><div class="p-3 rounded-4 bg-light"><div class="fw-bold fs-5">@(t.HinhThucDay == "Cả hai" ? "On/Off" : t.HinhThucDay)</div><div class="small text-muted">Hình thức dạy</div></div></div>
                <div class="col-4"><div class="p-3 rounded-4 bg-light"><div class="fw-bold fs-6 pt-1">@t.KhuVucDay</div><div class="small text-muted">Khu vực</div></div></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(t.ThanhTichNoiBat))
            {
                <div class="achieve-box mb-4"><strong><i class="fa-solid fa-award text-warning me-2"></i>Thành tích & chứng chỉ:</strong> @t.ThanhTichNoiBat</div>
            }

            <h6 class="fw-bold text-primary">Giới thiệu & phương pháp giảng dạy</h6>
            <div class="bio-html mb-4">@Html.Raw(SafeHtml.Clean(t.GioiThieuBio))</div>

            <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-book-open me-2"></i>Môn học & khối lớp nhận dạy</h6>
            @if (subjectGroups.Count == 0)
            {
                <p class="text-muted small">Gia sư chưa cập nhật môn dạy.</p>
            }
            else
            {
                <div class="mb-4">
                    @foreach (var g in subjectGroups)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <strong class="me-1" style="min-width:150px">@g.Key</strong>
                            @foreach (var k in g.Select(x => x.MaKhoiLopNavigation).OrderBy(k => k.MaKhoiLop)) { <span class="badge-soft m-0">@k.TenKhoiLop</span> }
                        </div>
                    }
                </div>
            }

            <h6 class="fw-bold text-primary mb-2"><i class="fa-regular fa-calendar-check me-2"></i>Ma trận lịch rảnh</h6>
            @if (t.MaTranLichRanh.Count == 0)
            {
                <p class="text-muted small">Gia sư chưa cập nhật lịch rảnh. Hãy ghi chú thời gian mong muốn khi đặt lịch.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="avail-table">
                        <thead><tr><th></th>@foreach (var d in VnFormat.Days) { <th>@d.Replace("Thứ ", "T").Replace("Chủ nhật", "CN")</th> }</tr></thead>
                        <tbody>
                            @foreach (var s in VnFormat.Sessions)
                            {
                                <tr>
                                    <th class="text-start">@s</th>
                                    @foreach (var d in VnFormat.Days)
                                    {
                                        bool ok = free.Contains(d + "|" + s);
                                        <td><div class="cell @(ok ? "free" : "")" title="@(ok ? "Còn trống" : "Đã kín") @VnFormat.SessionTimes[s]">@if (ok){<i class="fa-solid fa-check"></i>}else{<i class="fa-solid fa-minus"></i>}<small>@VnFormat.SessionTimes[s].Substring(0, 5)</small></div></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="small text-muted"><span class="badge bg-success-subtle text-success-emphasis">Xanh</span> = còn trống &nbsp; <span class="badge bg-light text-secondary">Xám</span> = đã kín</div>
            }
        </div>

        <div class="card-soft p-4 mb-4" id="reviews">
            <h5 class="fw-bold mb-4"><i class="fa-solid fa-comments text-primary me-2"></i>Đánh giá từ phụ huynh & học sinh</h5>
            @if (totalReviews > 0)
            {
                <div class="row g-4 mb-4 align-items-center">
                    <div class="col-md-4 text-center">
                        <div class="display-4 fw-bold">@((t.DiemDanhGiaTb ?? 0).ToString("0.0"))</div>
                        <partial name="_Stars" model="(t.DiemDanhGiaTb ?? 0)" />
                        <div class="small text-muted">@totalReviews đánh giá</div>
                    </div>
                    <div class="col-md-8">
                        @for (int s = 5; s >= 1; s--)
                        {
                            int c = Model.StarCounts.GetValueOrDefault(s);
                            <div class="d-flex align-items-center gap-2 small mb-1">
                                <span style="width:34px">@s <i class="fa-solid fa-star text-warning"></i></span>
                                <div class="rating-bar flex-grow-1"><div style="width:@(totalReviews == 0 ? 0 : c * 100 / totalReviews)%"></div></div>
                                <span class="text-muted" style="width:24px">@c</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @foreach (var r in visibleReviews)
            {
                <div class="d-flex gap-3 border-top pt-3 mt-3">
                    <partial name="_Avatar" model="@(new AvatarModel(r.MaPhuHuynhNavigation?.HoTen ?? "Ẩn danh", null, r.MaPhuHuynh, 40))" />
                    <div>
                        <div class="fw-semibold">@(r.MaPhuHuynhNavigation?.HoTen ?? "Ẩn danh") <span class="small text-muted fw-normal ms-2">@VnFormat.TimeAgo(r.NgayDanhGia)</span></div>
                        <partial name="_Stars" model="(double)r.SoSao" />
                        <div class="small text-secondary mt-1">@r.NoiDungBinhLuan</div>
                    </div>
                </div>
            }
            @if (totalReviews == 0)
            {
                <p class="text-muted">Chưa có đánh giá nào. Hãy là người đầu tiên chia sẻ trải nghiệm!</p>
            }

            <div class="mt-4 p-3 rounded-4 bg-light">
                @if (!Model.IsLoggedIn)
                {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="small">Đăng nhập bằng tài khoản Phụ huynh để gửi đánh giá.</span>
                        <a class="btn btn-sm btn-primary rounded-pill px-3" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnTo">Đăng nhập</a>
                    </div>
                }
                else if (!Model.IsParent)
                {
                    <span class="small text-muted">Chỉ tài khoản Phụ huynh / Học sinh mới có thể gửi đánh giá.</span>
                }
                else if (Model.HasReviewed)
                {
                    <span class="small text-success"><i class="fa-solid fa-circle-check me-1"></i>Bạn đã đánh giá gia sư này. Cảm ơn bạn!</span>
                }
                else
                {
                    <form asp-action="AddReview" method="post" novalidate>
                        <h6 class="fw-bold mb-2">Viết đánh giá của bạn</h6>
                        <input type="hidden" asp-for="Review.MaGiaSu" />
                        <div class="star-input mb-1">
                            @for (int s = 5; s >= 1; s--)
                            {
                                <input type="radio" id="star@(s)" name="Review.SoSao" value="@s" checked="@(Model.Review.SoSao == s)" />
                                <label for="star@(s)" title="@s sao"><i class="fa-solid fa-star"></i></label>
                            }
                        </div>
                        <span asp-validation-for="Review.SoSao"></span>
                        <textarea asp-for="Review.NoiDungBinhLuan" class="form-control mt-2" rows="3" placeholder="Chia sẻ trải nghiệm học với gia sư (10 - 500 ký tự)..."></textarea>
                        <span asp-validation-for="Review.NoiDungBinhLuan"></span>
                        <div class="text-end mt-2"><button class="btn btn-primary rounded-pill px-4">Gửi đánh giá</button></div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="sticky-side">
            <div class="card-soft p-4 mb-4" id="booking">
                <h5 class="fw-bold text-primary mb-1"><i class="fa-solid fa-paper-plane me-2"></i>Đăng ký học thử 01 buổi</h5>
                <p class="small text-muted mb-3">Gia sư sẽ liên hệ xác nhận qua số điện thoại bạn cung cấp.</p>

                @if (Model.IsOwnProfile)
                {
                    <div class="alert alert-info small mb-0">Đây là hồ sơ của bạn nên không thể tự đăng ký học thử.</div>
                }
                else
                {
                    <form asp-action="BookTrial" method="post" novalidate>
                        <input type="hidden" asp-for="Booking.MaGiaSu" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>
                        <div class="mb-3">
                            <label asp-for="Booking.HoTenPhuHuynh" class="form-label"></label>
                            <input asp-for="Booking.HoTenPhuHuynh" class="form-control" placeholder="VD: Chị Phạm Thị Lan" />
                            <span asp-validation-for="Booking.HoTenPhuHuynh"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Booking.SoDienThoai" class="form-label"></label>
                            <input asp-for="Booking.SoDienThoai" type="tel" class="form-control" placeholder="0912345678" />
                            <span asp-validation-for="Booking.SoDienThoai"></span>
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Booking.MaMonHoc" class="form-label"></label>
                                <select asp-for="Booking.MaMonHoc" class="form-select" asp-items="@(new SelectList(Model.BookableSubjects, "MaMonHoc", "TenMonHoc", Model.Booking.MaMonHoc))">
                                    <option value="">-- Chọn môn --</option>
                                </select>
                                <span asp-validation-for="Booking.MaMonHoc"></span>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label asp-for="Booking.TrinhDoHienTaiHS" class="form-label"></label>
                                <select asp-for="Booking.TrinhDoHienTaiHS" class="form-select">
                                    <option value="">-- Chọn trình độ --</option>
                                    @foreach (var lv in new[] { "Mất gốc - Cần lấy lại căn bản", "Trung bình", "Khá - Cần nâng cao", "Giỏi - Ôn thi chuyên/ĐH" })
                                    {
                                        <option value="@lv" selected="@(Model.Booking.TrinhDoHienTaiHS == lv)">@lv</option>
                                    }
                                </select>
                                <span asp-validation-for="Booking.TrinhDoHienTaiHS"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Booking.KhungGioMongMuon" class="form-label"></label>
                            <input asp-for="Booking.KhungGioMongMuon" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" min="@minTime" />
                            <span asp-validation-for="Booking.KhungGioMongMuon"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Booking.GhiChuYeuCau" class="form-label"></label>
                            <textarea asp-for="Booking.GhiChuYeuCau" class="form-control" rows="2" placeholder="VD: Cần gia sư kiên nhẫn, học sinh hay mất tập trung..."></textarea>
                            <span asp-validation-for="Booking.GhiChuYeuCau"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill"><i class="fa-regular fa-calendar-plus me-2"></i>Xác nhận đặt lịch học thử</button>
                        @if (!Model.IsLoggedIn)
                        {
                            <div class="small text-muted text-center mt-2">Có tài khoản? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnTo">Đăng nhập</a> để theo dõi trạng thái yêu cầu.</div>
                        }
                    </form>
                }
            </div>

            @if (Model.SimilarTutors.Any())
            {
                <div class="card-soft p-4">
                    <h6 class="fw-bold mb-3">Gia sư tương tự</h6>
                    @foreach (var s in Model.SimilarTutors)
                    {
                        <a asp-action="Details" asp-route-id="@s.MaGiaSu" class="d-flex align-items-center gap-3 text-decoration-none text-dark mb-3">
                            <partial name="_Avatar" model="@(new AvatarModel(s.MaNguoiDungNavigation.HoTen, s.MaNguoiDungNavigation.AnhDaiDien, s.MaGiaSu, 44))" />
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@s.MaNguoiDungNavigation.HoTen</div>
                                <div class="small text-muted">@s.TrinhDo • @s.HocPhiTheoGio.Vnd()/giờ</div>
                            </div>
                            @if ((s.TongSoDanhGia ?? 0) > 0) { <span class="small fw-bold text-warning"><i class="fa-solid fa-star"></i> @((s.DiemDanhGiaTb ?? 0).ToString("0.0"))</span> }
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (ViewBag.ScrollTo != null)
    {
        <script>document.getElementById('@ViewBag.ScrollTo')?.scrollIntoView({ behavior: 'smooth', block: 'center' });</script>
    }
}
