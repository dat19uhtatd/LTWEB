@model PagerViewModel
@if (Model.TotalPages > 1)
{
    string Link(int p)
    {
        var rv = new RouteValueDictionary();
        foreach (var kv in Model.Query) { if (!string.IsNullOrEmpty(kv.Value)) { rv[kv.Key] = kv.Value; } }
        rv["page"] = p;
        if (Model.Area != null) { rv["area"] = Model.Area; }
        return Url.Action(Model.Action, Model.Controller, rv) ?? "#";
    }
    <nav aria-label="Phân trang" class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">&laquo;</a></li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.Page) <= 1)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" href="@Link(p)">@p</a></li>
                }
                else if (Math.Abs(p - Model.Page) == 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">&raquo;</a></li>
        </ul>
    </nav>
}
